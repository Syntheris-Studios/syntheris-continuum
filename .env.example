# Syntheris Continuum V5.1.0 Environment Configuration Template
# Copy this file to .env and modify paths as needed for your system

# ===== RIFE Model Paths (auto-detected if not specified) =====
# RIFE v4.26 installation path (supports exact FPS targeting)
# RIFE_V426_PATH=C:/Syntheris/RIFEv4.26_0921
# RIFE_V426_PATH=/usr/local/rife/v426

# RIFE HDv3 installation path (fallback for integer multipliers)
# RIFE_HDV3_PATH=./Practical-RIFE
# RIFE_HDV3_PATH=/usr/local/rife/hdv3

# ===== Directory Paths =====
# Output directory for processed videos
# SYNTHERIS_OUTPUT_DIR=./outputs
# SYNTHERIS_OUTPUT_DIR=/path/to/outputs

# Temporary files directory
# SYNTHERIS_TEMP_DIR=./temp
# SYNTHERIS_TEMP_DIR=/tmp/syntheris

# Upload directory for input files
# SYNTHERIS_UPLOAD_DIR=./uploads
# SYNTHERIS_UPLOAD_DIR=/path/to/uploads

# ===== V5.1.0 Research-Validated Processing Settings =====
# Duration validation tolerance (milliseconds) - research recommends <100ms
DURATION_TOLERANCE_MS=100

# Enable PTS reset to prevent timestamp accumulation
DEFAULT_PTS_RESET=true

# RIFE v4.26 research settings (sc=false, skip=false per research findings)
DEFAULT_SCENE_DETECTION=false
DEFAULT_FRAME_SKIPPING=false

# ===== Hardware & Performance Settings =====
# GPU memory fraction (0.1-1.0)
GPU_MEMORY_FRACTION=0.9

# Enable hardware encoding if available
ENABLE_HARDWARE_ENCODING=true

# Maximum parallel processing jobs
MAX_PARALLEL_JOBS=2

# ===== FFmpeg & Processing Settings =====
# Default video encoding quality (CRF value)
DEFAULT_CRF=18

# Default encoding preset (ultrafast, fast, medium, slow, veryslow)
DEFAULT_PRESET=fast

# Enable ATFI motion adaptation by default
DEFAULT_ATFI_ENABLED=false

# ATFI high motion FPS threshold
DEFAULT_ATFI_HIGH_FPS=60

# ===== Logging & Debug Settings =====
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable debug capture of intermediate files
DEBUG_CAPTURE=false

# Enable verbose processing logs
VERBOSE_LOGS=false

# ===== System Environment Variables =====

# CUDA device selection (0=first GPU, 1=second GPU, etc.)
CUDA_VISIBLE_DEVICES=0

# PyTorch CUDA memory allocation strategy
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ===== Research Validation Settings =====
# Enable mathematical validation of duration preservation
ENABLE_DURATION_VALIDATION=true

# Enable research compliance checking
ENABLE_RESEARCH_VALIDATION=true

# Default research preset
DEFAULT_RESEARCH_PRESET=24fps→60fps (RIFE v4.26 Optimized)

# ===== Advanced Settings =====
# Scene change detection threshold (0.0-1.0)
SCENE_THRESHOLD=0.3

# Motion detection threshold for ATFI (0.0-1.0)
ATFI_THRESHOLD=0.30

# Minimum segment duration for ATFI processing (seconds)
ATFI_MIN_DURATION=0.25

# ===== Cross-Platform Compatibility =====
# Force path separator (leave blank for auto-detection)
# FORCE_PATH_SEPARATOR=/
# FORCE_PATH_SEPARATOR=\

# Enable Windows long path support
ENABLE_LONG_PATHS=true

# ===== Network & Proxy Settings =====
# HTTP proxy for model downloads (if needed)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=https://proxy.company.com:8080

# ===== Security Settings =====
# Restrict file access to project directory
RESTRICT_FILE_ACCESS=true

# Maximum file size for uploads (MB)
MAX_UPLOAD_SIZE_MB=2048

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

# ===== Development & Testing =====
# Enable development mode features
DEV_MODE=false

# Skip RIFE model validation (for testing only)
SKIP_MODEL_VALIDATION=false

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Test video generation settings
TEST_VIDEO_DURATION=5.0
TEST_VIDEO_FPS=24.0
TEST_VIDEO_RESOLUTION=1920x1080